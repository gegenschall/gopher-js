    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@gopher-js/oxc-config": "workspace:*",
    "lefthook": "2.2.2",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "2.11.13"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@10.25.0"
