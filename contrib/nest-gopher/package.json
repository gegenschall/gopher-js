{
  "name": "@gopher-js/nest-gopher",
  "version": "0.0.1",
  "description": "A Gopher transport and controller decorators for NestJS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gegenschall/gopher-js.git",
    "directory": "contrib/nest-gopher"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gopher-js/core": "workspace:*",
    "@gopher-js/server": "workspace:*"
  },
  "devDependencies": {
    "@gopher-js/tsconfig": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@types/node": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.1.0"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
