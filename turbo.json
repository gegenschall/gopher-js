{
  "$schema": "https://turborepo.dev/schema.json",

  "globalDependencies": [
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "tooling/tsconfig/*.json",
    "tooling/vitest-config/*.ts"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
